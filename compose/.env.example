# Copy to .env and fill in. NEVER commit .env. Keep it chmod 600.
#   cp .env.example .env && chmod 600 .env
#
# Generate the secrets on the host (no network needed):
#   CALIBAN_ADMIN_TOKEN  openssl rand -hex 32
#   CALIBAN_KEK          openssl rand -base64 32     (exactly 32 random bytes, base64)
#   POSTGRES_PASSWORD    openssl rand -hex 24        (hex keeps it URL-safe for the DSN)
#   VALKEY_PASSWORD      openssl rand -hex 24
#
# One-liner that appends fresh values (then delete the empty lines below):
#   printf 'CALIBAN_ADMIN_TOKEN=%s\nCALIBAN_KEK=%s\nPOSTGRES_PASSWORD=%s\nVALKEY_PASSWORD=%s\n' \
#     "$(openssl rand -hex 32)" "$(openssl rand -base64 32)" "$(openssl rand -hex 24)" "$(openssl rand -hex 24)" >> .env
#
# BACK UP CALIBAN_KEK OFFLINE. Losing it makes every stored BYOK key unrecoverable.
#
# KEK rotation (core README, "KEK rotation"): put the new key in CALIBAN_KEK and the old one in
# CALIBAN_KEK_PREVIOUS, `docker compose up -d`, then `docker compose exec caliban caliban keys rotate`.
# When `docker compose exec caliban caliban keys status` shows "previous_keks_still_needed": [],
# empty CALIBAN_KEK_PREVIOUS and `up -d` again. Keep the old key offline for as long as you keep
# backups taken before the rotation, then destroy it (that is what makes deleted tenants'
# keys unrecoverable from those backups).

# ─── Caliban image ───
CALIBAN_IMAGE=caliban/caliban
CALIBAN_VERSION=0.1.0
CALIBAN_LOG=info
# TCP_NODELAY on Caliban's accepted connections (1 = on, 0 = off). Keep it on: on Linux, Nagle plus
# delayed ACK added 24 to 50 ms to the first streamed token (core bench/RESULTS-aws-2026-10.md).
CALIBAN_TCP_NODELAY=1

# Host interface for the published ports. 127.0.0.1 = local only (put a TLS reverse proxy
# in front). Use 0.0.0.0 or a specific NIC address to expose on the LAN.
CALIBAN_BIND=127.0.0.1
CALIBAN_ROUTER_PORT=8080
CALIBAN_CP_PORT=8081

# ─── Secrets (required) ───
CALIBAN_ADMIN_TOKEN=
CALIBAN_KEK=
# Retired KEKs (base64, comma separated), only during a rotation. Empty otherwise.
CALIBAN_KEK_PREVIOUS=
POSTGRES_PASSWORD=
VALKEY_PASSWORD=

# ─── Single sign-on for the console and admin API (optional; off while CALIBAN_OIDC_ISSUER is empty) ───
# OpenID Connect against your own identity provider (Keycloak, Entra ID, Okta, ADFS, Authentik,
# Dex, ...). Provider setup, roles and the route permissions: core docs/sso.md.
# The control plane must reach the issuer (discovery, signing keys, token endpoint). In this stack
# the caliban container has no route off the host, so also run the egress override and restrict
# the egress bridge to the identity provider, or go through your proxy (CALIBAN_HTTPS_PROXY):
#   docker compose -f docker-compose.yml -f docker-compose.byok-egress.yml up -d
# Issuer exactly as the provider's discovery document reports it, e.g.
#   https://keycloak.example.internal/realms/caliban
CALIBAN_OIDC_ISSUER=
CALIBAN_OIDC_CLIENT_ID=
# Confidential client secret. Leave empty for a public client (PKCE only).
CALIBAN_OIDC_CLIENT_SECRET=
# The console's callback, registered at the provider, as browsers reach it (through your TLS
# proxy): https://caliban.example.internal/auth/callback. An https URL makes the session cookie
# Secure; http is for local testing only (http://127.0.0.1:8081/auth/callback).
CALIBAN_OIDC_REDIRECT_URL=
# Space or comma separated. Empty = openid profile email.
CALIBAN_OIDC_SCOPES=
# Claim with the user's groups (dotted path for nested claims). Empty = groups.
CALIBAN_OIDC_GROUPS_CLAIM=
# Accept access tokens for this audience on the admin API (CI, scripts). Empty = console only.
CALIBAN_OIDC_API_AUDIENCE=
# PEM bundle of extra CA certificates for the provider (internal PKI), as a path inside the
# container. Mount it in docker-compose.yml under caliban.volumes, e.g.
#   - ./config/idp-ca.pem:/etc/caliban/idp-ca.pem:ro
CALIBAN_OIDC_CA_FILE=
# Identity provider groups (comma separated) that get a deployment role. Tenant roles are granted
# in the console (Users and roles) or with [[security.oidc.role_mappings]] in config/caliban.toml.
CALIBAN_OIDC_OWNER_GROUPS=
CALIBAN_OIDC_ADMIN_GROUPS=
CALIBAN_OIDC_AUDITOR_GROUPS=
# false = refuse CALIBAN_ADMIN_TOKEN once an owner can sign in with SSO (needs SSO). Empty keeps
# the token as the break-glass credential: every use is logged and audited.
CALIBAN_BREAK_GLASS=

# ─── Local model servers (see README "Running open models") ───
# Host directory with the weights, one sub-directory per model (layout: airgap/models.lock.yaml;
# download on a connected machine with `airgap/bundle.sh fetch`).
MODELS_DIR=./models

# qwen3-small: Qwen3.5-9B on vLLM (1×24 GB). Online FP8 keeps the weights at ~11 GB.
QWEN3_SMALL_GPU=0
QWEN3_SMALL_GPU_UTIL=0.70
QWEN3_SMALL_MAX_MODEL_LEN=131072
QWEN3_SMALL_QUANTIZATION=fp8_per_tensor
QWEN3_SMALL_KV_CACHE_DTYPE=auto

# qwen3-large: Qwen3.8-27B-FP8 on vLLM (1×48 GB at 131072 with fp8 KV; 1×80 GB: 262144).
QWEN3_LARGE_GPU=0
QWEN3_LARGE_TP=1
QWEN3_LARGE_GPU_UTIL=0.82
# Concurrent sequences. vLLM's default runs out of memory on 48 GB when the CUDA graphs are
# profiled; 32 was measured to fit next to embed and rerank. Raise it on 80 GB.
QWEN3_LARGE_MAX_NUM_SEQS=32
QWEN3_LARGE_MAX_MODEL_LEN=131072
QWEN3_LARGE_KV_CACHE_DTYPE=fp8

# qwen3-moe: Qwen3.6-35B-A3B-FP8 on vLLM (throughput tier, 1×48/80 GB).
QWEN3_MOE_GPU=0
QWEN3_MOE_TP=1
QWEN3_MOE_GPU_UTIL=0.85
QWEN3_MOE_MAX_MODEL_LEN=131072
QWEN3_MOE_KV_CACHE_DTYPE=fp8

# gpt-oss: gpt-oss-20b on vLLM (16 GB+).
GPT_OSS_GPU=0
GPT_OSS_GPU_UTIL=0.85
GPT_OSS_MAX_MODEL_LEN=131072

# embeddings (TEI, GPU) and reranker (vLLM pooling). They share a GPU with a chat pool:
# keep the *_GPU_UTIL fractions plus ~1.5 GB for TEI under the card's memory.
EMBED_GPU=0
RERANK_GPU=0
RERANK_GPU_UTIL=0.10
RERANK_MAX_MODEL_LEN=8192

# cpu profile (llama.cpp + TEI CPU)
# path under MODELS_DIR, and the name the server answers to (= upstream_model in caliban.toml)
QWEN3_CPU_GGUF=qwen3.6-35b-a3b-gguf/Qwen3.6-35B-A3B-Q4_K_M.gguf
QWEN3_CPU_ALIAS=ggml-org/Qwen3.6-35B-A3B-GGUF
LLM_CTX=32768
LLM_THREADS=8
LLM_PARALLEL=2

# ollama profile
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=2

# ─── BYOK (optional; requires docker-compose.byok-egress.yml) ───
# Referenced from config/caliban.toml as api_key = { env = "ACME_OPENAI_API_KEY" }.
# Prefer storing keys through the admin console (sealed under a per-tenant key wrapped by CALIBAN_KEK) instead.
ACME_OPENAI_API_KEY=

# ─── Telemetry (off unless set; point at YOUR collector only) ───
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Image overrides for a private registry (written by airgap/load.sh --registry) ───
# POSTGRES_IMAGE=registry.internal:5000/library/postgres:17.11-bookworm
# QDRANT_IMAGE=registry.internal:5000/qdrant/qdrant:v1.19.1-unprivileged
# VALKEY_IMAGE=registry.internal:5000/valkey/valkey:9.1.2
# VLLM_IMAGE=registry.internal:5000/vllm/vllm-openai:v0.30.0
# LLAMACPP_IMAGE=registry.internal:5000/ggml-org/llama.cpp:server-b11347
# TEI_IMAGE=registry.internal:5000/huggingface/text-embeddings-inference:cuda-1.9.4
# TEI_CPU_IMAGE=registry.internal:5000/huggingface/text-embeddings-inference:cpu-1.9.4
# OLLAMA_IMAGE=registry.internal:5000/ollama/ollama:0.35.0

# ── PII NER model (L1) ──
# Fetch on a connected machine:  python ml/scripts/fetch_pii_ner.py   (see core/crates/caliban-pii/MODELS.md)
# then copy ml/artifacts/pii_ner to CALIBAN_PII_MODEL_DIR on this host.
CALIBAN_PII_MODEL_DIR=./models/pii
CALIBAN_PII_NER_DIR=/models/pii/nym-pii-multilingual-small-int8/3.0.0
CALIBAN_PII_NER_SESSIONS=2
