# The images the demo pulls on the gateway host (run-demo.sh pull), pinned to exact versions.
# Sourced by run-demo.sh and record-term.sh; override any of them from the environment.
#
# Playwright 1.63.0 (2026-09-15) for Python on Ubuntu 24.04: Chromium, its video recorder, Python 3.
: "${DEMO_PLAYWRIGHT_IMAGE:=mcr.microsoft.com/playwright/python:v1.63.0-noble}"
# agg 1.9.0 (2026-05-29): asciicast to GIF.
: "${DEMO_AGG_IMAGE:=ghcr.io/asciinema/agg:1.9.0}"
# FFmpeg 8.0.3 on Ubuntu 24.04 (libx264): GIF and WebM to MP4, cuts, concatenation, chapters.
: "${DEMO_FFMPEG_IMAGE:=jrottenberg/ffmpeg:8.0.3-ubuntu2404}"
