      "checks": [
        { "type": "json_schema", "schema": { "type": "object",
          "properties": { "specialty": { "const": "orthopedics" }, "facility": { "type": "object", "properties": { "city": { "const": "paris" } } } } } },
        { "type": "contains", "value": ["svc-ortho-consult"] }
      ]
    },
    {
      "id": "fr-child-tripoli",
