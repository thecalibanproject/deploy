                          "facility": { "type": "object", "properties": { "city": { "const": "beirut" } } } } } },
        { "type": "regex", "pattern": "\"code\":\"svc-card-" },
        { "type": "llm_judge", "rubric": "The answer recommends a cardiology service at a Beirut facility from the catalogue, does not diagnose, and does not ask for personal data.", "threshold": 0.7 }
      ]
    },
    {
      "id": "en-knee-clarify",
      "tags": ["en", "orthopedics", "human-step"],
      "input": { "case": "My knee is swollen and painful after a fall." },
