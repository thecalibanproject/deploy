{
  "cases": [
    {
      "id": "en-chest-beirut",
      "tags": ["en", "cardiology", "no-clarification"],
      "input": { "case": "I have had chest pain and palpitations since Tuesday. I live in Beirut." },
      "checks": [
        { "type": "json_schema", "schema": { "type": "object", "required": ["services", "facility", "message"],
